NEXT_PUBLIC_API_URL_LOCAL=http://127.0.0.1:3001/v1
NEXT_PUBLIC_API_URL_PRODUCTION=http://13.126.105.138:3001/v1
NEXT_PUBLIC_API_PORT=3001
NEXT_PUBLIC_API_TARGET=production

# Optional Google Sign-In (OAuth Web client ID). Same value as API GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Cloud Messaging (optional browser push)
# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging → Web Push certificates → Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
